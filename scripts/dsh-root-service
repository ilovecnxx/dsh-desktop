#!/usr/bin/env bash
# 免密管理 root 测试服务与属主同步（由 setup-root.sh 安装到 /usr/local/sbin）
set -euo pipefail
action="${1:-}"
case "$action" in
  start|stop|restart|is-active)
    exec /usr/bin/systemctl "$action" dsh-web-root.service
    ;;
  owner-start|owner-stop|owner-restart|owner-is-active)
    exec /usr/bin/systemctl "${action#owner-}" dsh-owner-sync.service
    ;;
  *)
    echo "用法: $0 {start|stop|restart|is-active|owner-start|owner-stop|owner-restart|owner-is-active}" >&2
    exit 2
    ;;
esac
