{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness",
  "version": "1.4.4",
  "description": "DeepSeek Harness desktop client for Linux with one-click self-update",
  "main": "main/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "install:app": "bash scripts/install-app.sh",
    "test": "node --test test/*.test.js",
    "dist:dir": "electron-builder --linux dir",
    "dist:linux": "electron-builder --linux deb AppImage",
    "dist": "electron-builder --linux deb AppImage"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dsh-desktop",
    "productName": "DeepSeek Harness",
    "copyright": "Copyright © 2026 ilovecnxx",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main/**/*",
      "preload/**/*",
      "assets/**/*",
      "scripts/**/*",
      "package.json",
      "README.md",
      "CHANGELOG.md"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "icon": "assets/icon-512.png",
      "maintainer": "ilovecnxx <246518221+ilovecnxx@users.noreply.github.com>",
      "synopsis": "DeepSeek Harness desktop client for Linux",
      "description": "DeepSeek Harness Linux desktop client with one-click updates and service health monitoring.",
      "syncDesktopName": true
    }
  },
  "author": {
    "name": "ilovecnxx",
    "email": "246518221+ilovecnxx@users.noreply.github.com"
  },
  "desktopName": "dsh-desktop"
}
